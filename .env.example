# ==============================================================================
# SAP CDS Intelligence & Automation Platform - Environment Configuration
# ==============================================================================

# Platform Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_PORT=8000
APP_HOST=127.0.0.1
DEBUG=True

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (PostgreSQL with async engine)
# For local dev fallback when Postgres is not running, backend defaults to sqlite+aiosqlite:///./platform.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sap_cds_platform
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ==============================================================================
# SAP ADT Connector Settings (Milestone 8 Controlled Live Integration)
# ==============================================================================
# NOTE: .env contains sensitive credentials and is strictly ignored by git (.gitignore).
# Never commit credentials, passwords, tokens, or live URLs to version control.

# Mode & Safety Gates:
# - SAP_CONNECTOR_TYPE=stub : Isolated offline mock mode (default).
# - SAP_CONNECTOR_TYPE=adt  : Active ADT connector.
# - SAP_LIVE_READ_ONLY=true : Mandatory kill switch. Live connector refuses to execute if not true.
# - SAP_LIVE_TEST_ENABLED=true: Opt-in flag to run pytest tests/test_sap_adt_integration.py.
SAP_CONNECTOR_ENABLED=False
SAP_CONNECTOR_TYPE=stub
SAP_LIVE_READ_ONLY=False
SAP_LIVE_TEST_ENABLED=False

# SAP S/4HANA System Identity
SAP_SYSTEM_ID=DEV
SAP_CLIENT=100
SAP_S4HANA_RELEASE=2023
SAP_S4CORE_RELEASE=108 SP03
SAP_BASIS_RELEASE=758 SP03

# SAP ADT Network & Auth Settings
# Target URL format: https://<sap-host>:<port> (e.g. https://s4dev.corp.internal:44300)
SAP_BASE_URL=
SAP_AUTH_TYPE=basic
SAP_USERNAME=
SAP_PASSWORD=
SAP_API_TOKEN=

# TLS Security (Secure Default: True. Never disable TLS verification for production/corporate systems)
SAP_VERIFY_SSL=True
# Optional path to corporate enterprise root certificate bundle if using internal CA:
# SAP_CA_BUNDLE_PATH=C:/certs/corp_ca.pem

# Client Routing (Optional: append sap-client query parameter if required by SAP environment)
SAP_SEND_CLIENT_PARAM=False
SAP_REQUEST_TIMEOUT_SECONDS=15

# LLM / Agent Orchestration Configuration
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=60
