# ==============================================================================
# SAP CDS Intelligence & Automation Platform - Environment Configuration
# ==============================================================================

# Platform Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_PORT=8000
APP_HOST=127.0.0.1
DEBUG=True

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (PostgreSQL with async engine)
# For local dev fallback when Postgres is not running, backend defaults to sqlite+aiosqlite:///./platform.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sap_cds_platform
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Future SAP Connector Settings (Placeholder - NO active connection or credentials in Milestone 1)
SAP_CONNECTOR_ENABLED=False
SAP_CONNECTOR_TYPE=stub
SAP_SYSTEM_ID=DEV
SAP_CLIENT=100
SAP_S4HANA_RELEASE=2023
SAP_S4CORE_RELEASE=108 SP03
SAP_BASIS_RELEASE=758 SP03

# LLM / Agent Orchestration Configuration
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=60
